# Giá trị không nhạy cảm; sao chép ra ngoài repo rồi bổ sung bí mật bằng secret store.
AllowedHosts=api.example.invalid
ReadAccess__PublicApiOrigin=https://api.example.invalid
ReadAccess__UrlTtlSeconds=120
Cors__AllowedOrigins__0=https://app.example.invalid
# Chỉ IP thật của reverse proxy; không dùng mạng công cộng hoặc wildcard.
ReverseProxy__KnownProxies__0=127.0.0.1
Database__InitializeOnStartup=false
DataProtection__ApplicationName=CloudDMS.Production.Cluster1
DataProtection__KeyRingPath=/keys
DataProtection__CertificatePath=/run/secrets/data-protection.pfx
SecurityRedis__CommandTimeoutMilliseconds=1000
SecurityRedis__ConnectTimeoutMilliseconds=2000
SearchIndex__Enabled=true
SearchIndex__MaxScanBytes=26214400
SearchIndex__ClamAvCoverageConfirmed=false
SearchIndex__ScanTimeoutSeconds=3600
SearchIndex__RetentionMinutes=60
SearchIndex__TokenizerEndpoint=http://embedding:8001/
SearchIndex__PdfTextExecutable=/usr/bin/pdftotext
SearchIndex__ModelVersion=intfloat/multilingual-e5-small@614241f622f53c4eeff9890bdc4f31cfecc418b3
Embedding__Endpoint=http://embedding:8001/
Embedding__ModelVersion=intfloat/multilingual-e5-small@614241f622f53c4eeff9890bdc4f31cfecc418b3
Embedding__BatchSize=16
Embedding__TimeoutSeconds=120
Qdrant__Endpoint=http://qdrant:6333/
Qdrant__TimeoutSeconds=120
Preview__Enabled=false
Preview__Endpoint=http://preview:8002/
Preview__ConverterVersion=libreoffice-sandbox-v1
ClamAV__Enabled=true
ClamAV__Host=clamav
ClamAV__Port=3310
ClamAV__TimeoutSeconds=3600
Upload__MaxStorageBytes=53687091200
Upload__MaxStagingBytesPerProvider=214748364800
# Bắt buộc cấp riêng, không lưu giá trị thật tại đây:
# ConnectionStrings__DefaultConnection (user ứng dụng riêng, không root)
# SecurityRedis__ConnectionString (redis:6379,password=...,abortConnect=false)
# JwtSettings__SecretKey, JwtSettings__Issuer, JwtSettings__Audience
# AesSettings__Key (xem cấu hình AES thực tế trong runbook)
# Qdrant__ApiKey, DataProtection__CertificatePassword, SMTP/cloud credentials

RateLimiting__SearchPerMinute=30
RateLimiting__AuthPerMinute=10
RateLimiting__UploadPerMinute=10
